<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CTW MF-78 — Espaço do Estudante</title>
<style>
:root{
  --green:#45a88f; --green-dark:#2f917a; --green-soft:#e8f5f1;
  --ink:#263238; --muted:#7a858c; --bg:#f4f6f7; --card:#fff;
  --line:#e5e9eb; --pink:#ef79a9; --blue:#4f6edb; --yellow:#e5bc3b;
  --shadow:0 8px 24px rgba(31,46,56,.07);
}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit}
button{cursor:pointer}
.app{min-height:100vh}
.topbar{
  height:74px;background:var(--green);color:#fff;display:flex;align-items:center;
  padding:0 28px;gap:24px;position:sticky;top:0;z-index:20;box-shadow:0 2px 12px rgba(0,0,0,.08)
}
.brand-mark{display:flex;align-items:center;gap:10px;margin-right:18px}
.brand-mark .mini-c{width:42px;height:42px;border:4px solid #fff;border-right-color:transparent;border-radius:50%;opacity:.95}
.logo-weg{height:38px;width:62px;object-fit:contain;filter:brightness(0) invert(1)}
.logo-senai{height:30px;width:92px;object-fit:contain;filter:brightness(0) invert(1)}
.brand-sep{height:28px;width:1px;background:rgba(255,255,255,.45)}
.nav{display:flex;align-items:stretch;height:100%;gap:4px;flex:1}
.nav button{border:0;background:transparent;color:#fff;padding:7px 12px;min-width:86px;font-size:12px;opacity:.9;display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;border-bottom:3px solid transparent}
.nav button:hover,.nav button.active{background:rgba(0,0,0,.08);border-bottom-color:#fff;opacity:1}
.nav .ico{font-size:18px;line-height:1}
.avatar{width:38px;height:38px;border-radius:50%;background:#e7eef6;color:#40536b;display:grid;place-items:center;font-weight:800;border:2px solid #fff;box-shadow:0 0 0 2px rgba(255,255,255,.2)}
.hero{background:var(--green);color:#fff;padding:34px 0 38px;border-radius:0 0 18px 18px}
.shell{width:min(1180px,calc(100% - 40px));margin:0 auto}
.hero-grid{display:grid;grid-template-columns:1.35fr .8fr;gap:44px;align-items:start}
.hero h1{font-size:34px;line-height:1.16;margin:0 0 16px;font-weight:800}
.hero-name{display:flex;align-items:center;gap:12px;font-size:21px;font-weight:800;margin-bottom:8px}
.student-avatar{width:42px;height:42px;border-radius:50%;background:#fff;color:var(--green-dark);display:grid;place-items:center;font-size:16px;font-weight:800}
.enroll{display:inline-flex;align-items:center;gap:8px;background:rgba(0,0,0,.12);padding:8px 12px;border-radius:18px;font-size:12px}
.quick{display:flex;gap:18px;margin-top:20px;flex-wrap:wrap}
.quick a{color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px;font-size:13px}
.quick .qbox{width:36px;height:36px;border-radius:7px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:18px}
.notice-head{font-size:19px;font-weight:800;margin:6px 0 12px}
.notice-empty{background:rgba(255,255,255,.12);padding:16px;border-radius:12px;display:flex;align-items:center;gap:12px}
.notice-empty .ring{width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.5);display:grid;place-items:center}
.content{padding:26px 0 44px}
.grid2{display:grid;grid-template-columns:1.6fr 1fr;gap:24px}
.stack{display:grid;gap:24px}
.card{background:var(--card);border:1px solid #e1e5e8;border-radius:12px;box-shadow:var(--shadow)}
.card-head{display:flex;justify-content:space-between;align-items:center;padding:15px 16px 10px}
.card-head h2{font-size:16px;margin:0}
.card-head a{color:var(--green-dark);font-size:12px;text-decoration:none}
.calendar{padding:0 16px 16px}
.calendar-layout{display:grid;grid-template-columns:215px 1fr;gap:16px}
.month{padding:10px}
.month h3{margin:0 0 10px;font-size:14px}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;font-size:10px;text-align:center;color:#6d777d}
.cal-grid b{color:#9aa2a7}
.day{width:26px;height:26px;display:grid;place-items:center;border-radius:50%}
.day.active{background:var(--green);color:#fff;font-weight:800}
.events{display:grid;gap:7px;align-content:start;padding-top:10px}
.event{border:1px solid #e0e4e7;border-left:4px solid var(--pink);padding:9px 10px;border-radius:7px;display:flex;justify-content:space-between;align-items:center}
.event strong{font-size:12px}
.event small{display:block;color:var(--muted);margin-top:3px}
.score-row{display:flex;gap:10px;overflow:auto;padding:0 16px 16px}
.score{min-width:170px;border:1px solid #e2e5e7;border-radius:10px;padding:10px;background:#fff}
.score .tag{font-size:11px;line-height:1.2;font-weight:800}
.score .value{font-size:20px;font-weight:800;margin-top:16px}
.score .sub{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;border-top:1px solid #eee;margin-top:10px;padding-top:8px}
.news{display:grid;gap:9px;padding:0 16px 16px}
.news-item{display:grid;grid-template-columns:58px 1fr;gap:10px;border:1px solid #e0e4e7;border-radius:10px;padding:9px}
.datebox{background:#f8d9e7;color:#d64f8a;border-radius:8px;display:grid;place-items:center;font-weight:800;line-height:1.05;padding:7px}
.datebox small{font-size:9px}
.news-item strong{font-size:12px}
.news-item p{margin:5px 0 0;font-size:12px;color:#505b61}
.blog{display:grid;grid-template-columns:82px 1fr;gap:11px;padding:0 16px 16px}
.blog strong{font-size:12px;color:var(--green-dark)}
.blog p{font-size:12px;margin:5px 0;color:#5b6469}
.page{display:none}
.page.active{display:block}
.page-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}
.page-title h1{font-size:24px;margin:0}
.page-title p{margin:5px 0 0;color:var(--muted);font-size:12px}
.select{border:1px solid #dce2e5;padding:9px 12px;border-radius:8px;background:#fff}
.course-card{padding:16px;border-radius:12px;background:#fff;border:1px solid #e0e4e7;box-shadow:var(--shadow);margin-bottom:16px}
.course-card h2{font-size:16px;margin:0 0 8px}
.meta-line{display:flex;flex-wrap:wrap;gap:14px;color:#6e787d;font-size:11px}
.tabs{display:flex;gap:5px;border-bottom:1px solid #e2e5e7;margin-top:16px}
.tabs button{border:0;background:transparent;padding:10px 12px;color:#6e777c;font-size:11px;border-bottom:2px solid transparent}
.tabs button.active{color:var(--green-dark);border-bottom-color:var(--green-dark)}
.panel{padding-top:16px}
.term-list{display:grid;gap:8px}
.term{background:#fff;border:1px solid #e0e4e7;border-radius:9px;overflow:hidden}
.term-head{padding:13px 14px;display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:700}
.term-body{display:none;padding:0 14px 12px;border-top:1px solid #edf0f2}
.term.open .term-body{display:block}
.subject{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #eff2f3;font-size:11px}
.badge{padding:5px 7px;border-radius:6px;font-size:9px;font-weight:800}
.badge.ok{background:#def4ea;color:#1f8b62}
.badge.warn{background:#fff0dd;color:#b87412}
.badge.pending{background:#ffe4e8;color:#cf4454}
.schedule{overflow:auto}
.schedule-grid{min-width:760px;display:grid;grid-template-columns:80px repeat(6,1fr);border:1px solid #e1e5e8;border-radius:10px;overflow:hidden;background:#fff}
.schedule-grid>div{border-right:1px solid #edf0f2;border-bottom:1px solid #edf0f2;padding:10px;font-size:10px;min-height:58px}
.schedule-grid .head{background:#f4f7f7;font-weight:800;text-align:center}
.finance-grid,.docs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.info-box{padding:17px;background:#fff;border:1px solid #e1e5e8;border-radius:12px;box-shadow:var(--shadow)}
.info-box h3{font-size:14px;margin:0 0 6px}
.info-box .big{font-size:24px;font-weight:800}
.info-box p{font-size:11px;color:var(--muted);margin:6px 0 0}
.doc{padding:16px;border:1px solid #e1e5e8;border-radius:10px;background:#fff}
.doc .icon{width:36px;height:36px;border-radius:8px;background:var(--green-soft);color:var(--green-dark);display:grid;place-items:center;margin-bottom:10px}
.doc button,.info-box button{border:1px solid #cfd9d9;background:#fff;padding:7px 10px;border-radius:7px;font-size:11px}
.profile-menu{position:fixed;right:26px;top:64px;background:#fff;border:1px solid #e0e4e7;border-radius:10px;box-shadow:0 15px 35px rgba(0,0,0,.15);width:210px;padding:8px;display:none;z-index:30}
.profile-menu.open{display:block}
.profile-menu button{width:100%;text-align:left;border:0;background:#fff;padding:10px;border-radius:7px;font-size:12px}
.profile-menu button:hover{background:#f4f7f7}
.toast{position:fixed;right:22px;bottom:22px;background:#24343b;color:#fff;padding:12px 14px;border-radius:8px;font-size:12px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:.2s;pointer-events:none}
.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:980px){
  .hero-grid,.grid2{grid-template-columns:1fr}
  .nav button{min-width:72px;padding:6px 5px;font-size:10px}
  .finance-grid,.docs-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:700px){
  .topbar{padding:0 10px;gap:8px;overflow:auto}
  .brand-sep,.logo-weg,.logo-senai{display:none}
  .nav button{min-width:60px}
  .shell{width:min(100% - 20px,1180px)}
  .hero{padding-top:24px}
  .hero h1{font-size:27px}
  .calendar-layout{grid-template-columns:1fr}
  .finance-grid,.docs-grid{grid-template-columns:1fr}
}
</style>
</head>
