<script>
const stateKey = "ctw-mf78-portal-v1";
const defaultState = {name:"Felipe Meireles da Silva",semester:"2026/2"};
let state = JSON.parse(localStorage.getItem(stateKey) || "null") || defaultState;

const toast = (msg) => {
  const el = document.getElementById("toast");
  el.textContent = msg; el.classList.add("show");
  clearTimeout(window._toast); window._toast = setTimeout(()=>el.classList.remove("show"),1800);
};

function saveState(){ localStorage.setItem(stateKey, JSON.stringify(state)); }

function showPage(page) {
  document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));
  const pageEl = document.getElementById("page-"+page);
  if(pageEl) pageEl.classList.add("active");
  document.getElementById("home-hero").classList.toggle("active", page==="home");
  document.querySelectorAll("#nav button[data-page]").forEach(b=>b.classList.toggle("active", b.dataset.page===page));
  window.scrollTo({top:0,behavior:"smooth"});
}

document.querySelectorAll("#nav button[data-page]").forEach(btn=>btn.addEventListener("click",()=>showPage(btn.dataset.page)));
document.querySelectorAll("[data-toast]").forEach(el=>el.addEventListener("click",(e)=>{e.preventDefault();toast(el.dataset.toast)}));

document.getElementById("profileBtn").addEventListener("click",()=>document.getElementById("profileMenu").classList.toggle("open"));
document.addEventListener("click",(e)=>{
  const m=document.getElementById("profileMenu"), b=document.getElementById("profileBtn");
  if(!m.contains(e.target) && e.target!==b) m.classList.remove("open");
});
document.querySelectorAll("[data-action]").forEach(btn=>btn.addEventListener("click",()=>{
  const a=btn.dataset.action;
  if(a==="export"){
    const blob=new Blob([JSON.stringify({...state,exportedAt:new Date().toISOString()},null,2)],{type:"application/json"});
    const link=document.createElement("a"); link.href=URL.createObjectURL(blob); link.download="ctw-mf78-portal-dados.json"; link.click(); URL.revokeObjectURL(link.href); toast("Dados exportados");
  } else if(a==="import") document.getElementById("importFile").click();
  else if(a==="profile") toast("Perfil do estudante aberto");
  else if(a==="settings") toast("Configurações abertas");
  document.getElementById("profileMenu").classList.remove("open");
}));
document.getElementById("importFile").addEventListener("change",(e)=>{
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=()=>{ try { const x=JSON.parse(r.result); state={...defaultState,...x}; saveState(); document.getElementById("semester").value=state.semester; toast("Dados importados"); } catch { toast("Arquivo inválido"); } };
  r.readAsText(f);
});

document.getElementById("semester").addEventListener("change",(e)=>{state.semester=e.target.value;saveState();toast("Período alterado")});

const panel = document.getElementById("performance-panel");
function renderPerformance(tab="boletim") {
  const subjects = [
    ["Aprimoramento Profissional","—","0 faltas","pending"],
    ["Desenho CAD 2D","9,70","4 faltas","ok"],
    ["Desenvolvimento de Sistemas de Automação","9,10","2 faltas","ok"],
    ["Processos de Fabricação Mecânica","9,09","3 faltas","ok"],
    ["Manutenção Mecânica Aplicada","8,80","1 falta","ok"]
  ];
  if(tab==="boletim"){
    panel.innerHTML = `<div class="term-list">${
      subjects.map((s,i)=>`<div class="term">
        <div class="term-head"><span>${s[0]}</span><span>›</span></div>
        <div class="term-body">
          <div class="subject"><span>Média parcial</span><strong>${s[1]}</strong></div>
          <div class="subject"><span>Frequência</span><span class="badge ${s[3]}">${s[2]}</span></div>
          <div class="subject"><span>Situação</span><span class="badge ${i===0?'pending':'ok'}">${i===0?'EM ABERTO':'REGULAR'}</span></div>
        </div></div>`).join("")
      }</div>`;
    panel.querySelectorAll(".term-head").forEach(h=>h.addEventListener("click",()=>h.parentElement.classList.toggle("open")));
  } else if(tab==="notas"){
    panel.innerHTML = `<div class="term-list">${subjects.map(s=>`<div class="subject" style="padding:13px 4px"><span>${s[0]}</span><strong>${s[1]}</strong></div>`).join("")}</div>`;
  } else if(tab==="freq"){
    panel.innerHTML = `<div class="term-list">${subjects.map(s=>`<div class="subject" style="padding:13px 4px"><span>${s[0]}</span><span>${s[2]}</span></div>`).join("")}</div>`;
  } else if(tab==="plano"){
    panel.innerHTML = `<div class="term-list">
      <div class="term"><div class="term-head"><span>Plano de Ensino — Manutenção Mecânica</span><span>›</span></div><div class="term-body"><p style="font-size:11px;color:#5c666b">Conteúdos, objetivos, competências e critérios de avaliação disponíveis para consulta.</p></div></div>
      <div class="term"><div class="term-head"><span>Plano de Ensino — Processos de Fabricação</span><span>›</span></div><div class="term-body"><p style="font-size:11px;color:#5c666b">Consulte o detalhamento dos módulos do componente curricular.</p></div></div>
    </div>`;
    panel.querySelectorAll(".term-head").forEach(h=>h.addEventListener("click",()=>h.parentElement.classList.toggle("open")));
  } else {
    panel.innerHTML = `<div class="info-box"><h3>Acompanhamento Fora da Empresa</h3><p>Registros, orientações e acompanhamento das atividades práticas aparecem aqui.</p><div style="margin-top:14px"><span class="badge ok">ATIVO</span></div></div>`;
  }
}
document.querySelectorAll("[data-tab]").forEach(btn=>btn.addEventListener("click",()=>{
  document.querySelectorAll("[data-tab]").forEach(x=>x.classList.remove("active")); btn.classList.add("active"); renderPerformance(btn.dataset.tab);
}));
renderPerformance();

document.getElementById("moreBtn").addEventListener("click",()=>{showPage("help");toast("Mais opções")});
saveState();
</script>
</body>
</html>
